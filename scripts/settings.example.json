{
  "env": {
    "CODEGURU_BASE_URL": "https://api.sambanova.ai/v1",
    "CODEGURU_AUTH_TOKEN": "<your-api-key>",
    "CODEGURU_MODEL": "MiniMax-M2.7",
    "CODEGURU_DEFAULT_HAIKU_MODEL": "MiniMax-M2.7",
