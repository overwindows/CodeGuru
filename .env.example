# Example environment variables for Anthropic API access.
# The shipping CLI often uses ~/.claude/settings.json or OAuth instead — see SETUP.md.

# ANTHROPIC_API_KEY=

# Optional overrides (see src/utils/model/model.ts and related files):
# ANTHROPIC_MODEL=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_SMALL_FAST_MODEL=
# ANTHROPIC_DEFAULT_SONNET_MODEL=
# ANTHROPIC_DEFAULT_OPUS_MODEL=
# ANTHROPIC_DEFAULT_HAIKU_MODEL=
