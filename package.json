{
  "name": "codeguru",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "description": "Dev harness for CodeGuru; application source is in src/",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "codeguru": "./src/entrypoints/cli.tsx"
  },
  "scripts": {
    "check-env": "python3 scripts/check-dev-environment.py",
    "codeguru": "bun run ./src/entrypoints/cli.tsx",
    "dev": "bun run ./src/entrypoints/cli.tsx",
    "build": "bun build --compile --target=bun-windows-x64 --outfile=dist/codeguru.exe ./src/entrypoints/cli.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
